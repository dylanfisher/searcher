#!/usr/bin/env bash
# Time the harness cases in a release build and check them against the budgets
# in docs/performance.md. Builds any missing W1–W3 fixture under
# $TMPDIR/searcher-bench, records the top CPU processes, warns when another
# process is busy, writes .build/bench.json and exits non-zero on a budget
# miss. Arguments pass through to the runner:
#   --path <dir>          point the cases at a real folder
#   --print-budget <id>   print one budget's number, for other scripts
#   --print-stall-arguments
#                         print the app arguments that start its stall watchdog at B10
#   --cold-children <dir> time 20 different subfolders of <dir>, once each, against B3;
#                         the folders must not have been opened before
#   --check-idle          sample the machine for 1 s; exit non-zero naming any
#                         busy process
#   compare <previous> <current>
#                         report cases whose median is over 10% slower than in <previous>
#                         (a missing file is stated); exit non-zero when <current> has a
#                         case over budget
#   compare-ui <previous history> <bench-ui.json> <branch>
#                         judge a UI bench record against the history the last CI run
#                         kept (a missing file is stated) and write the next one to
#                         .build/bench-ui-history.json; a UI case is report-only until
#                         its p95 stays within 10% across 3 runs on one branch; exit
#                         non-zero when an enforced case is over budget or the record
#                         is missing or doesn't hold one run's 20 launches
#   --ui                  build the release Searcher.app and time its UI in 20 new
#                         processes (B1, B2, B6, B7, B8, B10; B6 in column view too)
#                         instead of the harness cases; writes .build/bench-ui.json. With
#                         --path, the folder is opened as both W1 and W2. The window opens
#                         in the background on the second display if there is one and
#                         never takes focus; a run whose window is covered fails saying
#                         so. The bundle is built at .build/bench/Searcher.app.
#   --ui --scenario <name>
#                         one launch that times one scenario instead, and writes
#                         .build/bench-ui-<name>.json. cold, revisit and column-walk time
#                         a share's folder and need --path, which never has a default.
#                         cold: once per mount; run before revisit. A second cold run on
#                         the same mount passes with warm numbers. --help lists the
#                         scenarios
#   --help                print this, then the scenarios
set -euo pipefail
cd "$(dirname "$0")/.."

if [ "${1:-}" = --help ]; then
  # The comment block above, without its leading "# ".
  sed -n '2,/^set -euo/{/^#/s/^# \{0,1\}//p;}' "$0"
fi

args=()
ui=false
for argument in "$@"; do
  if [ "$argument" = --ui ]; then ui=true; else args+=("$argument"); fi
done
if $ui; then
  # Its own path, so the dev bundle at .build/Searcher.app, which may be running
  # and holds its Full Disk Access grant, is left alone.
  app=$(./scripts/bundle -c release -o .build/bench/Searcher.app)
  args=(--ui "$PWD/$app" ${args[@]+"${args[@]}"})
fi

# Build output goes to stderr so `--print-budget` leaves only the number on stdout.
swift build -c release --product Bench >&2
exec "$(swift build -c release --show-bin-path)/Bench" ${args[@]+"${args[@]}"}
