#!/usr/bin/env bash
# Time the harness cases in a release build and check them against the budgets
# in docs/performance.md. Builds any missing W1–W3 fixture under
# $TMPDIR/searcher-bench, records the top CPU processes, warns when another
# process is busy, writes .build/bench.json and exits non-zero on a budget
# miss. The harness copies a 1 GB file to a disk image through FileCopier,
# judged in MB/s against spike S7, and the --ui run copies W8 to one. For
# those two runs this script first checks that $TMPDIR's volume has room for
# the source fixture and the image, failing with the bytes needed and free
# before anything is written, then creates a sparse APFS image there,
# attaches it outside /Volumes, and detaches and removes it when the run ends,
# failed or not. Arguments pass through to the runner:
#   --path <dir>          point the cases at a real folder
#   --print-budget <id>   print one budget's number, for other scripts
#   --print-stall-arguments
#                         print the app arguments that start its stall watchdog at B10
#   --cold-children <dir> time 20 different subfolders of <dir>, once each, against B3;
#                         the folders must not have been opened before
#   --check-idle          sample the machine for 1 s; exit non-zero naming any
#                         busy process
#   compare <previous> <current>
#                         report cases whose median is over 10% slower than in <previous>
#                         (a missing file is stated); exit non-zero when <current> has a
#                         case over budget
#   compare-ui <previous history> <bench-ui.json> <branch>
#                         judge a UI bench record against the history the last CI run
#                         kept (a missing file is stated) and write the next one to
#                         .build/bench-ui-history.json; a UI case is report-only until
#                         its p95 stays within 10% across 3 runs on one branch; exit
#                         non-zero when an enforced case is over budget or the record
#                         is missing or doesn't hold one run's 20 launches
#   --ui                  build the release Searcher.app and time its UI in 20 new
#                         processes (B1, B2, B6, B7, B8, B10; B6 in column view, in
#                         splits and while the queue copies W8 to a disk image with
#                         the operations panel open, B10 over that copy, B2 in ten
#                         panes too) instead of the harness cases; writes
#                         .build/bench-ui.json. W8 is 10 GB and needs about 20.5 GB
#                         free in $TMPDIR the first time, 10.5 GB once built. With
#                         --path, the folder is opened as both W1 and W2. The window opens
#                         in the background on the second display if there is one and
#                         never takes focus; a run whose window is covered fails saying
#                         so. The bundle is built at .build/bench/Searcher.app.
#   --ui --w8-2gb         copy W8's 2 GB variant instead, as CI does; about 4.5 GB
#                         free the first time
#   --ui --scenario <name>
#                         one launch that times one scenario instead, and writes
#                         .build/bench-ui-<name>.json. cold, revisit and column-walk time
#                         a share's folder and need --path, which never has a default.
#                         cold: once per mount; run before revisit. A second cold run on
#                         the same mount passes with warm numbers. --help lists the
#                         scenarios
#   --help                print this, then the scenarios
set -euo pipefail
cd "$(dirname "$0")/.."

if [ "${1:-}" = --help ]; then
  # The comment block above, without its leading "# ".
  sed -n '2,/^set -euo/{/^#/s/^# \{0,1\}//p;}' "$0"
fi

args=()
ui=false
for argument in "$@"; do
  if [ "$argument" = --ui ]; then ui=true; else args+=("$argument"); fi
done
if $ui; then
  # Its own path, so the dev bundle at .build/Searcher.app, which may be running
  # and holds its Full Disk Access grant, is left alone.
  app=$(./scripts/bundle -c release -o .build/bench/Searcher.app)
  args=(--ui "$PWD/$app" ${args[@]+"${args[@]}"})
fi

# Build output goes to stderr so `--print-budget` leaves only the number on stdout.
swift build -c release --product Bench >&2
bench="$(swift build -c release --show-bin-path)/Bench"

# "<megabytes> <folder>" for a run that copies to a disk image, after the free
# space check; "0" for any other. A short check fails here, naming the bytes.
plan=$("$bench" --disk-image-size ${args[@]+"${args[@]}"})
read -r image_megabytes image_parent <<<"$plan"
if [ "$image_megabytes" = 0 ]; then
  exec "$bench" ${args[@]+"${args[@]}"}
fi

# Whether hdiutil lists an attached image whose path holds $1. Read whole
# before the search, so an early exit of grep can't cut hdiutil off and make an
# attached image read as detached.
image_attached() {
  local info
  info=$(hdiutil info) || return 1
  grep -qF "$1" <<<"$info"
}

# Whether the mount table lists anything at or under the folder $1. The table
# names folders by their resolved path, /private/var rather than /var.
mounted_under() {
  local resolved mounts
  resolved=$(cd "$1" 2>/dev/null && pwd -P) || return 1
  mounts=$(mount)
  grep -qF -e " on $resolved/" -e " on $resolved (" <<<"$mounts"
}

# Detaches $1, a device or a mount point, trying five times a second apart: a
# process the run started can hold a file on the image for a moment after it.
detach() {
  local try
  for try in 1 2 3 4 5; do
    if hdiutil detach -quiet -force "$1"; then return 0; fi
    [ "$try" = 5 ] || sleep 1
  done
  return 1
}

# Images earlier runs left behind, such as one killed with SIGKILL. A folder
# whose image is detached and that has nothing mounted under it is removed;
# one still attached is named, for the user to detach.
for old in "$image_parent"/searcher-bench-image.*; do
  [ -d "$old" ] || continue
  if image_attached "$(basename "$old")/image.sparseimage"; then
    echo "scripts/bench: an earlier run's image is still attached; detach it with" \
      "hdiutil detach -force \"$old/mount\" and remove $old" >&2
  elif mounted_under "$old"; then
    echo "scripts/bench: something is still mounted under $old; it is left" >&2
  else
    rm -rf "$old"
  fi
done

image_root=$(mktemp -d "$image_parent/searcher-bench-image.XXXXXX")
image_device=
# Detaches and removes the image however the run ends. The folder is removed
# only once nothing is mounted under it: removing it while mounted would delete
# through the mount point.
cleanup() {
  # Attached even when attach printed no device, so the image is looked up too.
  if [ -n "$image_device" ] ||
    image_attached "$(basename "$image_root")/image.sparseimage"; then
    if ! detach "${image_device:-$image_root/mount}"; then
      echo "scripts/bench: could not detach the image in $image_root; it is left" >&2
      return
    fi
  fi
  if mounted_under "$image_root"; then
    echo "scripts/bench: something is still mounted under $image_root; it is left" >&2
    return
  fi
  rm -rf "$image_root"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Sparse, so it takes only what is copied into it; APFS, so the copy crosses
# volumes and clones nothing.
hdiutil create -quiet -type SPARSE -size "${image_megabytes}m" -fs APFS \
  -volname SearcherBench "$image_root/image"
mkdir "$image_root/mount"
# The first line names the image's own device, which detaches the whole image.
image_device=$(hdiutil attach -nobrowse -noverify -noautoopen \
  -mountpoint "$image_root/mount" "$image_root/image.sparseimage" | awk 'NR == 1 { print $1 }')
if [ -z "$image_device" ]; then
  echo "scripts/bench: hdiutil attach named no device for $image_root/image.sparseimage" >&2
  exit 1
fi
# Keeps Spotlight from indexing what the run copies while it is timed.
touch "$image_root/mount/.metadata_never_index"

status=0
"$bench" ${args[@]+"${args[@]}"} --image "$image_root/mount" || status=$?
exit "$status"
