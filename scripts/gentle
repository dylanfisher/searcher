# Sourced by scripts/check and scripts/test; not run directly.
#
# Gentle mode leaves the machine usable while the suite runs. Enable it with
# `--gentle` as the first argument or SEARCHER_GENTLE=1. macOS cannot pin a
# process to N cores, so the build (the long, heavy phase) is limited to half the
# logical CPUs with `--jobs` and runs under `taskpolicy -c utility` (lower
# priority, still free to use P-cores when idle). The test run is left alone:
# capping Swift Testing's width (SWT_EXPERIMENTAL_MAXIMUM_PARALLELIZATION_WIDTH)
# made aLocalChangeEventUnderAFolderDropsItsSize and footprintGrowsWithTouchedMemory
# fail in 2 of 4 runs, and the priority policies break priority-asserting tests: under utility the
# process's default QoS drops with it, which fails FolderSizeServiceTests'
# priority comparison every run, and `-c background` (E-cores only, throttled
# I/O) also fails StallWatchdogTests and takes longer; `nice` fails the thread
# priority and footprint tests.
#
# swift_cmd <subcommand> [args...] runs `swift`; a build is throttled when gentle.

if [ "${1:-}" = "--gentle" ]; then SEARCHER_GENTLE=1; shift; fi

if [ "${SEARCHER_GENTLE:-}" = "1" ]; then
  export SEARCHER_GENTLE
  gentle_jobs=$(( $(sysctl -n hw.ncpu) / 2 ))
  [ "$gentle_jobs" -ge 1 ] || gentle_jobs=1
  swift_cmd() {
    local sub="$1"; shift
    if [ "$sub" = build ]; then taskpolicy -c utility swift build --jobs "$gentle_jobs" "$@"
    else swift "$sub" --jobs "$gentle_jobs" "$@"; fi
  }
  # check sources this, then runs test, which sources it again: announce once.
  if [ -z "${SEARCHER_GENTLE_ANNOUNCED:-}" ]; then
    export SEARCHER_GENTLE_ANNOUNCED=1
    echo "gentle mode: jobs $gentle_jobs, taskpolicy utility (build only)"
  fi
else
  swift_cmd() { swift "$@"; }
fi
