#!/usr/bin/env bash
# Run the app locally. The ONE place the run command is written down — AGENTS.md
# and README point here rather than repeating it, so there is
# nothing to keep in sync when a flag changes. Passes any extra args to
# scripts/bundle, so `./scripts/dev -c release` works without editing this file.
set -euo pipefail
cd "$(dirname "$0")/.."

# Launched as a bundle, not with `swift run`, so the system treats it as
# Searcher instead of a child of Terminal.
app=$(./scripts/bundle "$@")

# `open` brings a running copy to the front instead of starting the new build,
# so quit it first and wait until it has gone. The quit doesn't wait for a reply,
# so a hung copy hits the 5 s limit below rather than AppleScript's 2 minutes.
id=$(plutil -extract CFBundleIdentifier raw "$app/Contents/Info.plist")
running() { [ -n "$(lsappinfo info -only pid -app "$id")" ]; }
if running; then
  osascript -e "ignoring application responses" -e "quit app id \"$id\"" -e "end ignoring"
  for _ in $(seq 50); do running || break; sleep 0.1; done
  if running; then
    printf 'running %s did not quit within 5 s; quit it and run again\n' "$id" >&2
    exit 1
  fi
fi

open "$app"
