#!/usr/bin/env bash
# Run the app locally. The ONE place the run command is written down — AGENTS.md
# and README point here rather than repeating it, so there is
# nothing to keep in sync when a flag changes. Passes through any extra args, so
# `./scripts/dev -c release` works without editing this file.
set -euo pipefail
cd "$(dirname "$0")/.."

exec swift run Searcher "$@"
