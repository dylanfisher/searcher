#!/usr/bin/env bash
# Run the test suite. Passes through any extra args to the test runner,
# so `./scripts/test path/to/file` works for a focused run.
set -euo pipefail
cd "$(dirname "$0")/.."

# Command Line Tools ship the Swift Testing macro plugin in a subdirectory the
# default build system misses on a cold build ("plugin for module
# 'TestingMacros' not found"). Point at it explicitly when it exists.
plugins="$(dirname "$(xcrun --find swift)")/../lib/swift/host/plugins/testing"
flags=()
[ -d "$plugins" ] && flags=(-Xswiftc -plugin-path -Xswiftc "$plugins")

# The interface tests run one at a time, everything else in parallel. Reason and
# measurements: docs/decisions/0064-serial-interface-tests.md. A focused run (any
# args) is a single swift test call; it picks its own tests, so there is no split.
serial="InterfaceTests"

if [ $# -gt 0 ]; then exec swift test "${flags[@]}" "$@"; fi

status=0
swift test "${flags[@]}" --skip "$serial" || status=1
swift test "${flags[@]}" --filter "$serial" --no-parallel || status=1
exit "$status"
